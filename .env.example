# Copy this file to .env and fill in your real key. NEVER commit .env to git.
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here

# OpenAI-compatible endpoint (default is DeepSeek's public API)
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Model to use
MODEL=deepseek-chat

# Internal bind address/port (the reverse proxy forwards here)
HOST=127.0.0.1
PORT=5000

# Knowledge base location (relative to app.py, or absolute)
KB_PATH=knowledge/cheryl_ai_knowledgebase.txt

# Safety cap on how much of the KB is injected into the prompt
MAX_KB_CHARS=30000
