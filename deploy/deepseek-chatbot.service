[Unit]
Description=Chatbot Manager (Flask + Gunicorn)
After=network.target

[Service]
Type=simple
User={{APP_USER}}
Group={{APP_USER}}
WorkingDirectory={{APP_DIR}}
EnvironmentFile={{APP_DIR}}/.env
ExecStart={{APP_DIR}}/venv/bin/gunicorn --workers 2 --threads 2 --bind 127.0.0.1:{{PORT}} --timeout 120 app:app
Restart=always
RestartSec=3

# Light security hardening
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
